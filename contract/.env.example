# Environment variables for BuildBack deployment on Avalanche

# Avalanche Fuji Testnet RPC
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Avalanche Mainnet RPC
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Your wallet private key (DO NOT COMMIT THIS - add .env to .gitignore)
PRIVATE_KEY=your_private_key_here

# Snowtrace API key for contract verification
SNOWTRACE_API_KEY=your_snowtrace_api_key_here

# USDC Token Address on Fuji Testnet
# Official USDC on Fuji: 0x5425890298aed601595a70AB815c96711a31Bc65
USDC_TOKEN_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
